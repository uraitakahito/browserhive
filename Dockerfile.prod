# syntax=docker/dockerfile:1.7
#
# Production image for the BrowserHive HTTP server.
#
# The whole stack (this server + SeaweedFS + chromium workers) is normally
# brought up on Apple Container with `container-compose up -d -b` — see
# docker-compose.yml. To build and run just this image by hand:
#
# Build:
#   container build -f Dockerfile.prod -t browserhive:prod .
#
# Run (standalone, point at an external S3 and existing workers):
#   container run --rm -p 127.0.0.1:8080:8080 \
#     -e BROWSERHIVE_BROWSER_URLS=http://<worker-ip>:9222 \
#     -e BROWSERHIVE_S3_ENDPOINT=http://<s3-host>:8333 \
#     -e BROWSERHIVE_S3_BUCKET=browserhive \
#     -e BROWSERHIVE_S3_ACCESS_KEY_ID=... \
#     -e BROWSERHIVE_S3_SECRET_ACCESS_KEY=... \
#     browserhive:prod

ARG NODE_VERSION=24.15.0

# ---------- Builder stage ----------
FROM node:${NODE_VERSION}-bookworm-slim AS builder

WORKDIR /app

# Install all deps (including build-time tools like openapi-typescript, typescript).
# meadow's manifest comes along because it is a workspace member — the lockfile
# covers it, so the install would fail without it.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .puppeteerrc.json ./
COPY meadow/package.json meadow/

# After the COPY, not before: `corepack prepare --activate` with no argument
# reads package.json#packageManager, so it needs the manifest on disk. Passing
# the version here instead would duplicate the pin.
RUN corepack enable && corepack prepare --activate
RUN pnpm install --frozen-lockfile

# Sources the production build compiles (tsconfig.build.json = src + bin only;
# tests and examples are not shipped). redocly.yaml is required by the
# `openapi:lint` / `openapi:build-docs` steps; openapi-ts.config.ts and scripts/
# are required by `openapi:generate`. All run as part of `npm run build`.
#
# INVARIANT — this file has a partner. Dockerfile.prod.dockerignore is a
# WHITELIST (`*`, then `!` rules), and BuildKit pairs it to this Dockerfile BY
# NAME. A source added below with no matching `!` rule there never reaches the
# build context, and the build fails with
#   failed to calculate checksum of ref …: "/<file>": not found
# for a file that is plainly on disk and git-tracked. Nothing checks the
# pairing — CI builds on the host and never builds this image — so the two
# files have to be edited together. Do NOT work around it by building from a
# renamed copy of this Dockerfile: that unpairs the whitelist and ships the
# whole repo instead of fixing anything.
COPY tsconfig.json tsconfig.build.json tsconfig.generated.json tsconfig.behaviors.json redocly.yaml openapi-ts.config.ts ./
COPY src ./src
COPY bin ./bin
COPY scripts ./scripts

# Git revision and release tag baked into src/generated/version.ts (surfaced
# at /v1/status.build). The build context has no .git, so generate-version.mjs
# reads them from the environment rather than asking git. GIT_REV defaults to
# "dev"; GIT_TAG left empty makes the version "unknown" — which also becomes
# the `software` field baked into every archive, so pass it for a real build.
ARG GIT_REV=dev
ENV GIT_REV=$GIT_REV
ARG GIT_TAG=
ENV GIT_TAG=$GIT_TAG

# prep (openapi:generate + generate:version) via the prebuild hook + tsc -> ./dist
# (pnpm needs enablePrePostScripts in pnpm-workspace.yaml for that hook to fire)
RUN pnpm run build

# Collect exactly this package's production dependencies into one directory.
# This is what keeps the runtime image honest: a sibling workspace package's
# deps cannot end up here, because only browserhive's own prod graph is
# resolved. `--legacy` because pnpm v10+ otherwise wants
# inject-workspace-packages, which buys nothing here (browserhive depends on no
# other workspace package at runtime).
RUN pnpm --filter browserhive deploy --prod --legacy /deploy/app

# ---------- Runtime stage ----------
FROM node:${NODE_VERSION}-bookworm-slim AS runtime

# `openssl ts -verify` — the one check in signature verification that Node
# exposes no API for. The other three run in-process against Node's own
# OpenSSL; this is the only reason the binary is here, and ~6 MB is a smaller
# price than shipping archives that call themselves signed without anyone
# having checked the timestamp.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production

# No install step here. The runtime used to run `npm ci --omit=dev` against the
# root manifest, which also materialised the dev-only `meadow` tree and broke
# when its unrs-resolver stopped being hoisted (its postinstall needs
# napi-postinstall, which --omit=dev correctly removed). Copying the deploy
# output removes the whole failure mode: there is nothing left to resolve.
COPY --from=builder /deploy/app/node_modules ./node_modules
COPY --from=builder /deploy/app/package.json ./package.json

# Only what the server entry actually needs
COPY --from=builder /app/dist/src ./dist/src
COPY --from=builder /app/dist/bin ./dist/bin
# Pre-dereferenced OpenAPI spec produced by `scripts/openapi-bundle.mjs`
# during the build stage. The runtime server reads this JSON to wire up
# Fastify's Ajv schemas — the source YAML and @apidevtools/swagger-parser
# are deliberately absent from the runtime image.
#
# The Redoc HTML is also not shipped: docs are published as a static
# artifact via .github/workflows/docs.yml (GitHub Pages), and the
# running server has no /docs or /openapi.yaml endpoint.
COPY --from=builder /app/dist/openapi.dereferenced.json ./dist/openapi.dereferenced.json

# Entrypoint shim: optionally waits for the S3 endpoint (WAIT_FOR_S3) before
# exec'ing the server — see the script header for why.
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chown -R node:node /app

USER node

EXPOSE 8080

# Configuration is supplied via BROWSERHIVE_* environment variables
# (docker-compose.yml bakes them in; standalone runs pass `container run -e ...`).
# CLI flags still work and override env values.
ENTRYPOINT ["docker-entrypoint.sh"]
