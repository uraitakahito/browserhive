# syntax=docker/dockerfile:1.7
#
# Production image for the BrowserHive HTTP server.
#
# The whole stack (this server + SeaweedFS + chromium workers) is normally
# brought up on Apple Container with `container-compose up -d -b` — see
# docker-compose.yml. To build and run just this image by hand:
#
# Build:
#   container build -f Dockerfile.prod -t browserhive:prod .
#
# Run (standalone, point at an external S3 and existing workers):
#   container run --rm -p 127.0.0.1:8080:8080 \
#     -e BROWSERHIVE_BROWSER_URLS=http://<worker-ip>:9222 \
#     -e BROWSERHIVE_S3_ENDPOINT=http://<s3-host>:8333 \
#     -e BROWSERHIVE_S3_BUCKET=browserhive \
#     -e BROWSERHIVE_S3_ACCESS_KEY_ID=... \
#     -e BROWSERHIVE_S3_SECRET_ACCESS_KEY=... \
#     browserhive:prod

ARG NODE_VERSION=24.15.0

# ---------- Builder stage ----------
FROM node:${NODE_VERSION}-bookworm-slim AS builder

WORKDIR /app

# Install all deps (including build-time tools like openapi-typescript, typescript)
COPY package.json package-lock.json .npmrc .puppeteerrc.json ./
RUN npm ci

# Sources the production build compiles (tsconfig.build.json = src + bin only;
# tests and examples are not shipped). redocly.yaml is required by the
# `openapi:lint` / `openapi:build-docs` steps; openapi-ts.config.ts and scripts/
# are required by `openapi:generate`. All run as part of `npm run build`.
#
# INVARIANT — this file has a partner. Dockerfile.prod.dockerignore is a
# WHITELIST (`*`, then `!` rules), and BuildKit pairs it to this Dockerfile BY
# NAME. A source added below with no matching `!` rule there never reaches the
# build context, and the build fails with
#   failed to calculate checksum of ref …: "/<file>": not found
# for a file that is plainly on disk and git-tracked. Nothing checks the
# pairing — CI builds on the host and never builds this image — so the two
# files have to be edited together. Do NOT work around it by building from a
# renamed copy of this Dockerfile: that unpairs the whitelist and ships the
# whole repo instead of fixing anything.
COPY tsconfig.json tsconfig.build.json tsconfig.generated.json tsconfig.behaviors.json redocly.yaml openapi-ts.config.ts ./
COPY src ./src
COPY bin ./bin
COPY scripts ./scripts

# Git revision baked into src/generated/version.ts (surfaced at
# /v1/status.build). The build context has no .git, so generate-version.mjs
# reads it from GIT_REV rather than `git rev-parse`. Defaults to "dev".
ARG GIT_REV=dev
ENV GIT_REV=$GIT_REV

# prep (openapi:generate + generate:version) via the prebuild hook + tsc -> ./dist
RUN npm run build

# ---------- Runtime stage ----------
FROM node:${NODE_VERSION}-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production

# Production-only deps
COPY package.json package-lock.json .npmrc .puppeteerrc.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Only what the server entry actually needs
COPY --from=builder /app/dist/src ./dist/src
COPY --from=builder /app/dist/bin ./dist/bin
# Pre-dereferenced OpenAPI spec produced by `scripts/openapi-bundle.mjs`
# during the build stage. The runtime server reads this JSON to wire up
# Fastify's Ajv schemas — the source YAML and @apidevtools/swagger-parser
# are deliberately absent from the runtime image.
#
# The Redoc HTML is also not shipped: docs are published as a static
# artifact via .github/workflows/docs.yml (GitHub Pages), and the
# running server has no /docs or /openapi.yaml endpoint.
COPY --from=builder /app/dist/openapi.dereferenced.json ./dist/openapi.dereferenced.json

# Entrypoint shim: optionally waits for the S3 endpoint (WAIT_FOR_S3) before
# exec'ing the server — see the script header for why.
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chown -R node:node /app

USER node

EXPOSE 8080

# Configuration is supplied via BROWSERHIVE_* environment variables
# (docker-compose.yml bakes them in; standalone runs pass `container run -e ...`).
# CLI flags still work and override env values.
ENTRYPOINT ["docker-entrypoint.sh"]
